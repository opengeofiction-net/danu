#!/bin/bash
#
# Pre-flight code review: the same reviewer the pull request will get, run here
# first, on the diff against main by default.
#
#   cr                      review `git diff main` in the current repository
#   cr --diff-from <sha>    or any other flags hustcer/deepseek-review's cr takes
#   cr -n 12                review pull request #12 on GitHub instead
#
# Regenerates the CLI's config from the workflow on every run, so the prompt
# cannot drift from the one CI uses. Needs: nu on PATH, CHAT_TOKEN in the
# environment, and a checkout of hustcer/deepseek-review at DEEPSEEK_REVIEW
# (default ~/code/tools/deepseek-review), pinned to the same commit the
# workflow pins the action to.

set -u
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
tool=${DEEPSEEK_REVIEW:-$HOME/code/tools/deepseek-review}
cfg=${XDG_CONFIG_HOME:-$HOME/.config}/deepseek-review/config.yml

command -v nu >/dev/null || { echo "cr: nu (Nushell) is not on PATH" >&2; exit 1; }
[ -f "$tool/cr" ] || { echo "cr: no deepseek-review checkout at $tool" >&2; exit 1; }
# the token: from the environment, or from a file beside the config. The file
# is for shells that never see the export - a non-interactive bash returns from
# ~/.bashrc before it reaches one - and for not having the key in a profile at
# all. Mode 600, one line, no quoting
tokfile=${XDG_CONFIG_HOME:-$HOME/.config}/deepseek-review/token
if [ -z "${CHAT_TOKEN:-}" ] && [ -r "$tokfile" ]; then
	mode=$(stat -c %a "$tokfile" 2>/dev/null || echo '?')
	[ "$mode" = 600 ] || echo "cr: $tokfile is mode $mode; it holds a key and should be 600" >&2
	CHAT_TOKEN=$(head -n1 "$tokfile" | tr -d '[:space:]')
	export CHAT_TOKEN
fi
[ -n "${CHAT_TOKEN:-}" ] || {
	echo "cr: no DeepSeek token: set CHAT_TOKEN, or put it in $tokfile (mode 600)" >&2
	exit 1
}

# the tool keeps a version check in Nushell's persistent kv store, and opens
# it before it would create it; on a machine where nu has never run the
# directory does not exist and the run dies with "File not found". The store
# creates its own file once the directory is there
mkdir -p "${XDG_DATA_HOME:-$HOME/.local/share}/nushell"

# the action's own defaults for whatever the workflow leaves unset
python3 "$here/review-config.py" --action "$tool/action.yaml" --out "$cfg" || exit 1

# with no arguments, the diff against main; the tool's own default is the
# unstaged diff, which for a branch about to become a PR is usually empty
if [ $# -eq 0 ]; then
	base=$(git merge-base main HEAD 2>/dev/null) || {
		echo "cr: no local branch 'main' to diff against; pass --diff-from <sha>" >&2
		exit 1
	}
	set -- --diff-from "$base"
fi
exec nu "$tool/cr" --config "$cfg" "$@"
