#!/usr/bin/make -f
export PYBUILD_NAME=danu
%:
	dh $@ --with python3 --buildsystem=pybuild

# danu-soak forces zones to rebuild, which is a soak test and not something a
# fresh install should start doing on its own. Installed but left alone; it is
# enabled by hand for as long as a soak is wanted, and does nothing until the
# night count in /var/lib/danu/soak-remaining is seeded either way.
# The other four units are re-listed rather than left to a bare second
# dh_installsystemd call. A bare call takes every unit in the package, soak
# included, and emits a second maintscript block enabling any of them that
# carries an [Install] - which the soak timer does, so the tidier looking form
# quietly undoes the --no-enable above. The soak service is safe either way,
# because it has no [Install] at all; the timer is the one this protects.
# Adding a unit here means adding it to the second line too, or it ships
# un-enabled.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start danu-soak.service danu-soak.timer
	dh_installsystemd danu-build.service danu-build.timer \
		danu-backup.service danu-backup.timer
